global address_indirection_global: long = 44

function address_indirection_main ( ) {
    local a: long = 111
    local b: long = 222
    local c: long = 400

    local a_ptr: long = &a
    local b_ptr: long = &b
    local c_ptr: long = &c
    local address_indirection_global_ptr: long = &address_indirection_global

    return @a_ptr + @b_ptr + @c_ptr + @address_indirection_global_ptr
}
